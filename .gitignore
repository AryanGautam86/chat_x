# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# ---- Node / frontend ----
node_modules/
Frontend/dist/
Frontend/dist-ssr/
Frontend/dev-dist/
*.local

# ---- Secrets ----
.env
.env.*
!.env.example
# Generated when JWT_SECRET is unset; signs access tokens, must never ship.
Backend/data/jwt_secret

# ---- Runtime data (created by the app) ----
# Backend/data/index/ is committed on purpose: it ships the RAG index.
Backend/data/*.db
Backend/data/eval_results.json
Backend/frontend_dist/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editors / OS ----
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.sw?
