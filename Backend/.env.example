# Copy to Backend/.env and fill in. Never commit the real .env.

GEMINI_API_KEY=your-gemini-api-key

# Signs access tokens. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# If unset, a secret is generated into Backend/data/jwt_secret — fine for local
# dev, but SET THIS in production: the container filesystem is ephemeral, so a
# redeploy would otherwise sign every user out.
JWT_SECRET=

# Google sign-in. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your origins to
# "Authorised JavaScript origins" — e.g. http://localhost:5173 and your
# Render URL. Leave blank to hide the Google button entirely.
GOOGLE_CLIENT_ID=

# Optional overrides — defaults shown.
# CHAT_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=models/gemini-embedding-2
# DATABASE_URL=sqlite:///./data/app.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RETRIEVAL_K=3
# RETRIEVAL_SCORE_THRESHOLD=50
# CODE_EXEC_TIMEOUT=10
